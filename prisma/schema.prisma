generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String          @unique
  password        String
  role            String          @default("admin")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  fishingReports  FishingReport[]
  reviewsApproved Review[]        @relation("ReviewApprovedBy")
}

model Boat {
  id                     String          @id @default(cuid())
  name                   String
  slug                   String          @unique
  description            String?
  capacity               Int?
  length                 String?
  make                   String?
  model                  String?
  year                   Int?
  imageUrl               String?
  galleryImages          String[]
  meetingPointName       String?
  meetingPointAddress    String?
  meetingPointLatitude   Float?
  meetingPointLongitude  Float?
  active                 Boolean         @default(true)
  displayOrder           Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  bookings               Booking[]
  crewMembers            CrewMember[]
  blockedDates           BlockedDate[]
  fishingReports         FishingReport[]

  @@index([active, displayOrder])
}

model CrewMember {
  id           String   @id @default(cuid())
  boatId       String?
  boat         Boat?    @relation(fields: [boatId], references: [id], onDelete: SetNull)
  name         String
  role         String
  bio          String?
  imageUrl     String?
  phone        String?
  email        String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([boatId])
  @@index([active, displayOrder])
}

model Booking {
  id              String   @id @default(cuid())
  boatId          String?
  boat            Boat?    @relation(fields: [boatId], references: [id], onDelete: SetNull)
  charterType     String
  charterDuration String?
  charterDate     DateTime
  guestName       String
  guestEmail      String
  guestPhone      String
  guestCount      Int      @default(1)
  totalPrice      Float
  depositAmount   Float
  depositPaid     Boolean  @default(false)
  balancePaid     Boolean  @default(false)
  upgrades        String?
  notes           String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([boatId])
  @@index([charterDate])
  @@index([status])
}

model BlockedDate {
  id        String   @id @default(cuid())
  boatId    String?
  boat      Boat?    @relation(fields: [boatId], references: [id], onDelete: Cascade)
  date      DateTime
  bookingId String?
  reason    String?
  createdAt DateTime @default(now())

  @@unique([boatId, date])
  @@index([date])
}

model FishingReport {
  id         String               @id @default(cuid())
  boatId     String?
  boat       Boat?                @relation(fields: [boatId], references: [id], onDelete: SetNull)
  title      String
  date       DateTime             @default(now())
  conditions String?
  waterTemp  String?
  species    String[]
  catches    String?
  highlights String?
  hotspots   String?
  imageUrl   String?
  published  Boolean              @default(true)
  authorId   String
  author     User                 @relation(fields: [authorId], references: [id])
  images     FishingReportImage[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([boatId])
  @@index([date(sort: Desc)])
  @@index([published])
}

model FishingReportImage {
  id              String        @id @default(cuid())
  fishingReportId String
  fishingReport   FishingReport @relation(fields: [fishingReportId], references: [id], onDelete: Cascade)
  storageKey      String
  url             String
  altText         String?
  displayOrder    Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([fishingReportId, displayOrder])
}

model Review {
  id              String          @id @default(cuid())
  customerName    String
  customerEmail   String
  rating          Int
  title           String?
  reviewText      String
  charterDate     DateTime?
  status          String          @default("pending")
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?           @relation("ReviewApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  photos          ReviewPhoto[]
  consentRecords  ConsentRecord[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model ReviewPhoto {
  id           String   @id @default(cuid())
  reviewId     String
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  storageKey   String
  url          String
  originalName String?
  caption      String?
  approved     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([reviewId])
  @@index([approved])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  reviewId      String
  review        Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  consentType   String
  termsVersion  String
  termsText     String
  accepted      Boolean
  acceptedAt    DateTime
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([reviewId])
  @@index([customerEmail])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}