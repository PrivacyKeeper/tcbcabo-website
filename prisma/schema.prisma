generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/tcb_cabo_charters/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  fishingReports FishingReport[]
}

model Booking {
  id              String   @id @default(cuid())
  charterType     String
  charterDuration String?
  charterDate     DateTime
  guestName       String
  guestEmail      String
  guestPhone      String
  guestCount      Int      @default(1)
  totalPrice      Float
  depositAmount   Float
  depositPaid     Boolean  @default(false)
  balancePaid     Boolean  @default(false)
  upgrades        String?
  notes           String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([charterDate])
  @@index([status])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique
  bookingId String?
  reason    String?
  createdAt DateTime @default(now())
}

model FishingReport {
  id          String   @id @default(cuid())
  title       String
  date        DateTime @default(now())
  conditions  String?
  waterTemp   String?
  species     String[]
  catches     String?
  highlights  String?
  hotspots    String?
  imageUrl    String?
  published   Boolean  @default(true)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date(sort: Desc)])
  @@index([published])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}
